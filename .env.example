# Server-side only. Inject the real key via .env.local or deployment secrets.
ADMIN_API_TOKEN=
# Optional; defaults to data/ip-region under the project directory.
IP_REGION_DATA_DIR=
READING_MODE=parallel
# Shared by DeepSeek-V4.1-Flash text and Qwen Image 3.0 Pro via maas.qianwenaiapi.com.
MAAS_IMAGE_API_KEY=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Stable 32+ character random secret; same value in web and worker.
REPORT_SESSION_SECRET=
# Required before paid background tasks can run. User sets the production budget.
DAILY_MODEL_BUDGET_CNY=
# Confirm account's per-image price and record its version (<=16 characters).
IMAGE_PRICE_CNY=
IMAGE_PRICE_VERSION=
MODEL_TEXT_CONCURRENCY=2
MODEL_IMAGE_CONCURRENCY=1
MBTI_CACHE_DIR=.data/mbti
MBTI_CACHE_DAYS=30
